# Google Sheets
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Shifts
# Path to a service account JSON key file. Optional if sheet is public read.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/workspace/credentials/service_account.json

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Behavior
DEFAULT_TIMEZONE=America/New_York
REMINDER_MINUTES_BEFORE=5
POLL_INTERVAL_SECONDS=60
DRY_RUN=true

# State
STATE_DB_PATH=/workspace/data/reminders.db